# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# OS generated files
Thumbs.db
# Helm files
.helmignore
# GitHub
.github/
# Node modules
node_modules/
# Logs
*.log
# Temporary files
*.tgz
*.tar.gz
# Test files
*_test.go
test/
tests/
# Documentation
README.md
NOTES.txt
